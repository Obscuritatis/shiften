# Te vinden in Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key
# Publieke URL van de app (voor de bevestigingsmail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mails (bevestiging en herinnering) ---
# API-sleutel van resend.com
RESEND_API_KEY=re_...
# Afzender; vereist een geverifieerd domein bij Resend (zonder domein: enkel naar je eigen adres)
MAIL_AFZENDER=Shiften <shiften@jouwdomein.be>
# Geheime sleutel van Supabase (sb_secret_...), enkel op de server, nodig voor herinneringen
SUPABASE_SECRET_KEY=sb_secret_...
# Willekeurige lange tekst; Vercel stuurt die mee bij de dagelijkse herinnering
CRON_SECRET=kies-een-lange-willekeurige-tekst
# Alternatief voor Resend: bestaande mailbox via SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=jouw.adres@gmail.com
# SMTP_PASS=app-wachtwoord
